<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://cho.example.org/cho/0.1"
         xmlns="http://cho.example.org/cho/0.1#">

<owl:Ontology rdf:about="http://cho.example.org/cho/0.1">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clinical Hallucination Ontology (CHO). A formal evaluation framework for hallucinations in clinical language model outputs. See accompanying NeurIPS 2026 ED Track paper.</rdfs:comment>
  <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0.1.0</owl:versionInfo>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#hasFacet"/>

<owl:ObjectProperty rdf:about="#hasHarmTier">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasGenerationMechanism"/>

<owl:ObjectProperty rdf:about="#derivedFrom"/>

<owl:DatatypeProperty rdf:about="#hasNumericValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasUnit">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#derivedFromSourceText">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasNegation">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:AnnotationProperty rdf:about="#umls_cui"/>

<owl:AnnotationProperty rdf:about="#snomed_id"/>

<owl:AnnotationProperty rdf:about="#rxnorm_rxcui"/>

<owl:AnnotationProperty rdf:about="#loinc_code"/>

<owl:AnnotationProperty rdf:about="#icd10_code"/>

<owl:AnnotationProperty rdf:about="#hasHarmTierName"/>

<owl:AnnotationProperty rdf:about="#hasMechanismHint"/>

<owl:AnnotationProperty rdf:about="#detectionRule"/>

<owl:AnnotationProperty rdf:about="#verificationOracle"/>

<owl:AnnotationProperty rdf:about="#anchoredInTerminology"/>

<owl:Class rdf:about="#ClinicalHallucination">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <umls_cui rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NA (meta-class)</umls_cui>
</owl:Class>

<owl:Class rdf:about="#EntityHallucination">
  <rdfs:subClassOf rdf:resource="#ClinicalHallucination"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Errors at the concept level: a clinical entity is fabricated, substituted, or misgraded.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#FabricatedEntity">
  <rdfs:subClassOf rdf:resource="#EntityHallucination"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasHarmTier"/>
      <owl:someValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#T2_Misleading"/>
            <rdf:Description rdf:about="#T3_Actionable"/>
            <rdf:Description rdf:about="#T4_LifeThreatening"/>
          </owl:unionOf>
        </owl:Class>
      </owl:someValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A surface form that does not correspond to any existing UMLS CUI.</rdfs:comment>
  <detectionRule rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Surface form has no candidate UMLS CUI under string + abbreviation matching, and no near neighbor in the embedding space of known CUIs.</detectionRule>
  <verificationOracle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS Metathesaurus</verificationOracle>
</owl:Class>

<owl:Class rdf:about="#SubstitutedEntity">
  <rdfs:subClassOf rdf:resource="#EntityHallucination"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A valid UMLS CUI used in place of the intended one. Example: metoprolol named where metformin was meant.</rdfs:comment>
  <detectionRule rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Source-output entity alignment yields a pair of distinct CUIs with high contextual substitutability but no synonymy.</detectionRule>
  <verificationOracle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS synonymy graph</verificationOracle>
</owl:Class>

<owl:Class rdf:about="#MisgradedEntity">
  <rdfs:subClassOf rdf:resource="#EntityHallucination"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A correctly identified concept at the wrong severity or stage. Example: 'mild pneumonia' rendered as 'severe pneumonia'.</rdfs:comment>
  <detectionRule rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Source and output entities share UMLS CUI but differ on severity, stage, or grade qualifier.</detectionRule>
  <verificationOracle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SNOMED severity qualifier hierarchy</verificationOracle>
</owl:Class>

<owl:Class rdf:about="#RelationalHallucination">
  <rdfs:subClassOf rdf:resource="#ClinicalHallucination"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Errors in relations between correctly identified entities.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#InvertedRelation">
  <rdfs:subClassOf rdf:resource="#RelationalHallucination"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasHarmTier"/>
      <owl:someValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#T3_Actionable"/>
            <rdf:Description rdf:about="#T4_LifeThreatening"/>
          </owl:unionOf>
        </owl:Class>
      </owl:someValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cause-effect or temporal relation reversed. Example: 'insulin causes hypoglycemia' rendered as 'hypoglycemia causes insulin'.</rdfs:comment>
  <detectionRule rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Triple (a, r, b) appears in output where (b, r, a) is supported by the reference KG and (a, r, b) is not.</detectionRule>
  <verificationOracle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS / SNOMED relational graph</verificationOracle>
</owl:Class>

<owl:Class rdf:about="#ForbiddenRelation">
  <rdfs:subClassOf rdf:resource="#RelationalHallucination"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasHarmTier"/>
      <owl:someValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#T3_Actionable"/>
            <rdf:Description rdf:about="#T4_LifeThreatening"/>
          </owl:unionOf>
        </owl:Class>
      </owl:someValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relation not permitted by the reference ontology. Example: drug asserted to treat a condition outside its RxNorm indication list.</rdfs:comment>
  <detectionRule rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Triple (drug, treats, condition) appears in output where condition is not in the drug's RxNorm indication set.</detectionRule>
  <verificationOracle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RxNorm indications, SNOMED relational graph</verificationOracle>
</owl:Class>

<owl:Class rdf:about="#OvergeneralizedRelation">
  <rdfs:subClassOf rdf:resource="#RelationalHallucination"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Taxonomic over-jumping: a specific finding inferred as a broader diagnosis. Example: 'elevated troponin' rendered as 'myocardial infarction'.</rdfs:comment>
  <detectionRule rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Output concept is an ancestor (in UMLS is-a) of the source concept across at least one semantic-type boundary.</detectionRule>
  <verificationOracle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS Semantic Network</verificationOracle>
</owl:Class>

<owl:Class rdf:about="#TemporalHallucination">
  <rdfs:subClassOf rdf:resource="#ClinicalHallucination"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Errors in the clinical timeline.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SequenceInversion">
  <rdfs:subClassOf rdf:resource="#TemporalHallucination"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Order of two clinical events is reversed in the output relative to the source.</rdfs:comment>
  <detectionRule rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Extracted event pair (e1 before e2) in source appears as (e2 before e1) in output.</detectionRule>
</owl:Class>

<owl:Class rdf:about="#DurationFabrication">
  <rdfs:subClassOf rdf:resource="#TemporalHallucination"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A timeframe that is not in the source is asserted in the output.</rdfs:comment>
  <detectionRule rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Output contains a duration expression with no anchor in the source's temporal expressions.</detectionRule>
</owl:Class>

<owl:Class rdf:about="#CausalChainBreak">
  <rdfs:subClassOf rdf:resource="#TemporalHallucination"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A temporal causal link present in the source is severed in the simplification, changing the clinical narrative.</rdfs:comment>
  <detectionRule rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Source-side causal edge between events is not preserved in the output's event graph.</detectionRule>
</owl:Class>

<owl:Class rdf:about="#QuantitativeHallucination">
  <rdfs:subClassOf rdf:resource="#ClinicalHallucination"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Errors in numeric clinical content.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ValueFabrication">
  <rdfs:subClassOf rdf:resource="#QuantitativeHallucination"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A lab value or dosage is invented or copied incorrectly.</rdfs:comment>
  <detectionRule rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Numeric value in output for a LOINC-anchored lab does not match the source value, or exceeds physiologically plausible bounds.</detectionRule>
  <verificationOracle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LOINC + curated physiologic ranges</verificationOracle>
</owl:Class>

<owl:Class rdf:about="#UnitTransposition">
  <rdfs:subClassOf rdf:resource="#QuantitativeHallucination"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The value is preserved but the unit is changed (mg vs mcg, mmol vs mg/dL).</rdfs:comment>
  <detectionRule rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Same numeric value with mismatched unit between source and output.</detectionRule>
</owl:Class>

<owl:Class rdf:about="#DirectionError">
  <rdfs:subClassOf rdf:resource="#QuantitativeHallucination"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The qualitative direction of a value is reversed (high vs low, elevated vs decreased).</rdfs:comment>
  <detectionRule rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Output directional qualifier contradicts source qualifier for the same lab.</detectionRule>
</owl:Class>

<owl:Class rdf:about="#ThresholdViolation">
  <rdfs:subClassOf rdf:resource="#QuantitativeHallucination"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasHarmTier"/>
      <owl:someValuesFrom rdf:resource="#T4_LifeThreatening"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A numeric value is outside physiologically plausible bounds. This is a definitive ValueFabrication.</rdfs:comment>
  <detectionRule rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Numeric value exceeds the plausible bounds in the curated physiologic ranges table.</detectionRule>
  <verificationOracle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Curated physiologic ranges</verificationOracle>
</owl:Class>

<owl:Class rdf:about="#OmissionHallucination">
  <rdfs:subClassOf rdf:resource="#ClinicalHallucination"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Errors of absence: a clinically critical fact in the source is missing from the output.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CriticalOmission">
  <rdfs:subClassOf rdf:resource="#OmissionHallucination"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasHarmTier"/>
      <owl:someValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#T3_Actionable"/>
            <rdf:Description rdf:about="#T4_LifeThreatening"/>
          </owl:unionOf>
        </owl:Class>
      </owl:someValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A safety-critical fact (allergy, contraindication, do-not-resuscitate status) is dropped in simplification.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ModifierOmission">
  <rdfs:subClassOf rdf:resource="#OmissionHallucination"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasHarmTier"/>
      <owl:someValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#T3_Actionable"/>
            <rdf:Description rdf:about="#T4_LifeThreatening"/>
          </owl:unionOf>
        </owl:Class>
      </owl:someValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A negation or qualifier is lost. Example: 'no fever' rendered as 'fever'. Especially dangerous.</rdfs:comment>
  <detectionRule rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Negation cue present in source span is absent in the corresponding output span, or vice-versa.</detectionRule>
</owl:Class>

<owl:Class rdf:about="#ContextualOmission">
  <rdfs:subClassOf rdf:resource="#OmissionHallucination"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A qualifier is dropped, turning a hypothesis into a diagnosis. Example: 'possible PE' rendered as 'PE'.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ClinicalDomainFacet">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#PharmacologicalFacet">
  <rdfs:subClassOf rdf:resource="#ClinicalDomainFacet"/>
  <anchoredInTerminology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RxNorm</anchoredInTerminology>
</owl:Class>

<owl:Class rdf:about="#DiagnosticFacet">
  <rdfs:subClassOf rdf:resource="#ClinicalDomainFacet"/>
  <anchoredInTerminology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SNOMED CT</anchoredInTerminology>
  <anchoredInTerminology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ICD-10</anchoredInTerminology>
</owl:Class>

<owl:Class rdf:about="#LaboratoryFacet">
  <rdfs:subClassOf rdf:resource="#ClinicalDomainFacet"/>
  <anchoredInTerminology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LOINC</anchoredInTerminology>
</owl:Class>

<owl:Class rdf:about="#ProceduralFacet">
  <rdfs:subClassOf rdf:resource="#ClinicalDomainFacet"/>
  <anchoredInTerminology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SNOMED CT</anchoredInTerminology>
  <anchoredInTerminology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CPT</anchoredInTerminology>
</owl:Class>

<owl:Class rdf:about="#TemporalClinicalFacet">
  <rdfs:subClassOf rdf:resource="#ClinicalDomainFacet"/>
  <anchoredInTerminology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MIMIC-IV event timeline</anchoredInTerminology>
</owl:Class>

<owl:Class rdf:about="#HarmTier">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#T1_Cosmetic">
  <rdfs:subClassOf rdf:resource="#HarmTier"/>
  <hasHarmTierName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">T1 Cosmetic</hasHarmTierName>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No clinical consequence. Stylistic rephrasing only.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#T2_Misleading">
  <rdfs:subClassOf rdf:resource="#HarmTier"/>
  <hasHarmTierName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">T2 Misleading</hasHarmTierName>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Could cause confusion but unlikely to alter management.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#T3_Actionable">
  <rdfs:subClassOf rdf:resource="#HarmTier"/>
  <hasHarmTierName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">T3 Actionable</hasHarmTierName>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Could plausibly trigger an incorrect clinical decision.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#T4_LifeThreatening">
  <rdfs:subClassOf rdf:resource="#HarmTier"/>
  <hasHarmTierName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">T4 LifeThreatening</hasHarmTierName>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Could result in wrong treatment, missed diagnosis, or patient death.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#GenerationMechanism">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#KnowledgeBoundaryOverreach">
  <rdfs:subClassOf rdf:resource="#GenerationMechanism"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Model extrapolates beyond what its training data supports, producing fabricated entities or relations.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SynonymConflation">
  <rdfs:subClassOf rdf:resource="#GenerationMechanism"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distinct concepts collapse because their surface forms are similar (e.g., metoprolol/metformin).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#TemplateOverfitting">
  <rdfs:subClassOf rdf:resource="#GenerationMechanism"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Model emits simplification patterns that fit training templates regardless of the actual source.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#NegationDropout">
  <rdfs:subClassOf rdf:resource="#GenerationMechanism"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Negations are systematically lost during simplification.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#TemporalAnchorDrift">
  <rdfs:subClassOf rdf:resource="#GenerationMechanism"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Time expressions lose their reference point, producing duration or sequence errors.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SpecificityCollapse">
  <rdfs:subClassOf rdf:resource="#GenerationMechanism"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Specific clinical concepts are rendered as generic ones; root cause of OvergeneralizedRelation.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CrossPatientContamination">
  <rdfs:subClassOf rdf:resource="#GenerationMechanism"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Content from one patient's note influences the simplification of another's, producing fabricated or substituted entities.</rdfs:comment>
</owl:Class>


</rdf:RDF>
